<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent">
	<ImageView
		android:id="@+id/image"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scaleType="fitXY" />
	<!-- Transparent tap targets laid over the rows drawn by Slint (see ui/widget.slint):
		padding 16dp, header 28dp, spacing 10dp, rows 26dp high. -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:paddingTop="54dp"
		android:paddingLeft="16dp"
		android:paddingRight="16dp">
		<FrameLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="10dp" />
		<FrameLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="10dp" />
		<FrameLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="10dp" />
		<FrameLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="10dp" />
		<FrameLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="26dp" android:layout_marginBottom="10dp" />
	</LinearLayout>
</FrameLayout>
